# Dashboard API base URL.
#
# This must be the FULL base the dashboard router is mounted at, including /dashboard — lib/api.ts
# appends paths like /api-keys directly to it. Setting it to /api/v1 makes every dashboard
# call 404, because that is the parent router and not the one serving these endpoints.
#
# Leave it unset unless you need to point at another origin: the default in lib/api.ts is already
# correct, and a relative value keeps requests on the Vite dev proxy.
VITE_API_URL=/api/v1/dashboard
