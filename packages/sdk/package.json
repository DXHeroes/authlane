{
  "name": "@authlane/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Authlane - OAuth connections for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @authlane/shared build",
    "build": "tsc",
    "predev": "pnpm --filter @authlane/shared build",
    "dev": "tsc --watch",
    "pretest": "pnpm --filter @authlane/shared build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @authlane/shared build",
    "test:coverage": "vitest --coverage",
    "pretype-check": "pnpm --filter @authlane/shared build",
    "type-check": "tsc --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "keywords": [
    "authlane",
    "oauth",
    "ai",
    "agents",
    "integrations",
    "sdk",
    "typescript"
  ],
  "author": "Authlane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxheroes/authlane.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "@authlane/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://authlane.io/docs",
  "bugs": {
    "url": "https://github.com/dxheroes/authlane/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
