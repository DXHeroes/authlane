{
  "name": "@authlane/integration-contracts",
  "version": "0.1.0",
  "description": "Versioned, language-neutral public integration contracts for Authlane",
  "license": "MIT",
  "author": "Authlane",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated/v1.json": "./generated/v1/integrations.json",
    "./schema/v1.json": "./schema/integration-manifest.schema.json"
  },
  "files": [
    "dist",
    "generated",
    "manifests",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "prebuild": "pnpm generate:check",
    "build": "tsc",
    "test": "pnpm generate:check",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authlane/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DXHeroes/authlane.git",
    "directory": "packages/integration-contracts"
  },
  "homepage": "https://authlane.io/docs",
  "bugs": {
    "url": "https://github.com/DXHeroes/authlane/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
