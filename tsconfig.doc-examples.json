{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./.tmp/doc-example-types",
    "paths": {
      "@authlane/ai": ["packages/ai/src/index.ts"],
      "@authlane/ai/mastra": ["packages/ai/src/mastra.ts"],
      "@authlane/ai/mcp": ["packages/ai/src/mcp.ts"],
      "@authlane/ai/openai": ["packages/ai/src/openai.ts"],
      "@authlane/ai/vercel": ["packages/ai/src/vercel.ts"],
      "@authlane/integration-*": ["integrations/*/index.ts"],
      "@authlane/react": ["packages/react/src/index.ts"],
      "@authlane/sdk": ["packages/sdk/src/index.ts"],
      "@authlane/shared": ["packages/shared/src/index.ts"]
    },
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [".tmp/doc-examples/**/*.ts", ".tmp/doc-examples/**/*.tsx"]
}
