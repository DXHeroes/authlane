# Database
DATABASE_URL=postgresql://authlane:authlane@localhost:5432/authlane

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Redis (optional, for token refresh jobs)
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# MCP Server (optional - only needed if testing MCP server)
# Get API key from: pnpm --filter @authlane/database seed
AUTHLANE_API_KEY=
AUTHLANE_USER_ID=test_user_dev
AUTHLANE_BASE_URL=http://localhost:3000
