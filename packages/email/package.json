{
  "name": "@authlane/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "pnpm run build && vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "email:dev": "email dev --port 3001"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "react": "19.1.1",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react-email": "^6.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
