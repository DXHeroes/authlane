{
  "name": "@authlane/react",
  "version": "0.1.0",
  "description": "React components for Authlane - OAuth connections for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "authlane",
    "oauth",
    "ai",
    "agents",
    "integrations",
    "react",
    "components",
    "hooks",
    "typescript"
  ],
  "author": "Authlane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxheroes/authlane.git",
    "directory": "packages/react"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@authlane/sdk": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "homepage": "https://authlane.io/docs",
  "bugs": {
    "url": "https://github.com/dxheroes/authlane/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
