{
  "name": "@authlane/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run tests/service-catalog.test.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:create": "dotenv -e ../../.env -- tsx src/create.ts",
    "migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "secrets:rewrap": "dotenv -e ../../.env -- tsx src/rewrap-secrets.ts",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "seed:catalog": "dotenv -e ../../.env -- tsx src/seed-catalog.ts"
  },
  "dependencies": {
    "@authlane/crypto": "workspace:*",
    "@authlane/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
