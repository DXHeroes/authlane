# Database
DATABASE_URL=postgresql://authlane:authlane@localhost:5432/authlane

# Versioned keyrings. Keep the current key first and retain previous keys during rotation.
# Format: key-id:64-hex-key[,previous-key-id:64-hex-key]
AUTHLANE_DATA_KEK_RING=
AUTHLANE_LOOKUP_KEY_RING=
AUTHLANE_REDIS_KEY_RING=

# Redis (required in production for caches, rate limiting, and token refresh)
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
