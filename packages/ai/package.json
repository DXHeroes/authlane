{
  "name": "@authlane/ai",
  "version": "0.1.0",
  "description": "Local AI framework adapters for Authlane user-scoped tools",
  "license": "MIT",
  "author": "Authlane",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "import": "./dist/mastra.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authlane/integration-airtable": "workspace:*",
    "@authlane/integration-attio": "workspace:*",
    "@authlane/integration-discord": "workspace:*",
    "@authlane/integration-github": "workspace:*",
    "@authlane/integration-gmail": "workspace:*",
    "@authlane/integration-google-calendar": "workspace:*",
    "@authlane/integration-google-drive": "workspace:*",
    "@authlane/integration-hubspot": "workspace:*",
    "@authlane/integration-jira": "workspace:*",
    "@authlane/integration-linear": "workspace:*",
    "@authlane/integration-microsoft-calendar": "workspace:*",
    "@authlane/integration-microsoft-mail": "workspace:*",
    "@authlane/integration-microsoft-sharepoint": "workspace:*",
    "@authlane/integration-notion": "workspace:*",
    "@authlane/integration-pipedrive": "workspace:*",
    "@authlane/integration-salesforce": "workspace:*",
    "@authlane/integration-slack": "workspace:*",
    "@authlane/integration-stripe": "workspace:*",
    "@authlane/sdk": "workspace:*",
    "@authlane/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.66"
  },
  "peerDependencies": {
    "@mastra/core": "^1.51.0",
    "@openai/agents": "^0.13.4"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mastra/core": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.16.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DXHeroes/authlane.git",
    "directory": "packages/ai"
  },
  "homepage": "https://authlane.io/docs",
  "bugs": {
    "url": "https://github.com/DXHeroes/authlane/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
