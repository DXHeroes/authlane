{
  "name": "authlane",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source platform for managing third-party integrations in AI agents and SaaS applications",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "defu": "6.1.5",
      "react": "19.1.1",
      "react-dom": "19.1.1",
      "drizzle-orm": "0.45.2",
      "esbuild": "0.25.0",
      "postcss": "8.5.10",
      "prismjs": "1.30.0",
      "yaml": "2.8.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@sentry-internal/node-cpu-profiler",
      "bcrypt",
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract",
      "msw",
      "puppeteer",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --filter=@authlane/api --filter=@authlane/dashboard --filter=@authlane/widget",
    "demo": "node scripts/demo.mjs start",
    "demo:test": "node scripts/demo.mjs test",
    "demo:down": "node scripts/demo.mjs down",
    "demo:reset": "node scripts/demo.mjs reset",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:repo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:performance": "node scripts/benchmark-hot-read.mjs",
    "test:repo": "vitest run scripts/benchmark-hot-read.test.ts scripts/biome-config.test.ts scripts/coolify-compose-config.test.ts scripts/docs-domain-contract.test.ts scripts/docs-quickstart.test.ts scripts/integration-contracts.test.ts scripts/license-contract.test.ts scripts/plugin-release-contract.test.ts scripts/readme-devex.test.ts --environment node",
    "test:performance:unit": "vitest run scripts/benchmark-hot-read.test.ts --environment node",
    "lint": "biome check .",
    "lint:runtime": "biome check apps/api/src apps/widget/src packages/crypto/src packages/database/src packages/shared/src",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "turbo run type-check && pnpm type-check:examples && pnpm type-check:performance",
    "type-check:examples": "tsc -p tsconfig.examples.json",
    "type-check:performance": "tsc -p tsconfig.performance.json",
    "contracts:generate": "pnpm --filter @authlane/integration-contracts generate",
    "contracts:check": "pnpm --filter @authlane/integration-contracts generate:check",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "./scripts/setup.sh",
    "db:create": "pnpm --filter @authlane/database db:create",
    "db:migrate": "pnpm --filter @authlane/database migrate",
    "db:generate": "pnpm --filter @authlane/database generate",
    "db:seed": "pnpm --filter @authlane/database seed",
    "db:studio": "pnpm --filter @authlane/database studio",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "release:pack": "pnpm build && node scripts/validate-npm-packages.mjs",
    "release:npm:prepare": "pnpm changeset:status && pnpm release:pack",
    "release:python:lock:check": "python3 scripts/validate-python-release-lock.py",
    "release:python:build": "pnpm release:python:lock:check && uv sync --project packages/python --frozen --no-dev --group release --no-install-project && uv run --project packages/python --no-sync uv build --clear --no-sources --no-build-isolation --out-dir packages/python/dist packages/python",
    "release:python:check": "pnpm release:python:build && uv run --project packages/python --no-sync twine check packages/python/dist/* && python3 scripts/validate-python-artifacts.py && python3 scripts/smoke-python-artifact.py packages/python/dist/*.whl && python3 scripts/smoke-python-artifact.py packages/python/dist/*.tar.gz"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@biomejs/biome": "^2.3.7",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "postgres": "^3.4.7",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
