%% Authlane Encryption Flow (AES-256-GCM)
%% Render with: https://mermaid.live

flowchart TB
    subgraph Encryption["Encryption Process"]
        direction TB
        E1[/"Plaintext<br/>(OAuth tokens)"/]
        E2["Generate Random IV<br/>(12 bytes)"]
        E3["Load Encryption Key<br/>(from env/Vault)"]
        E4["AES-256-GCM<br/>Encrypt"]
        E5["Get Auth Tag<br/>(16 bytes)"]
        E6["Concatenate:<br/>IV + Ciphertext + Tag"]
        E7["Base64 Encode"]
        E8[/"Encrypted String<br/>(stored in DB)"/]

        E1 --> E2
        E2 --> E3
        E3 --> E4
        E4 --> E5
        E5 --> E6
        E6 --> E7
        E7 --> E8
    end

    subgraph Decryption["Decryption Process"]
        direction TB
        D1[/"Encrypted String<br/>(from DB)"/]
        D2["Base64 Decode"]
        D3["Extract IV<br/>(first 12 bytes)"]
        D4["Extract Auth Tag<br/>(last 16 bytes)"]
        D5["Extract Ciphertext<br/>(middle bytes)"]
        D6["Load Encryption Key<br/>(from env/Vault)"]
        D7["AES-256-GCM<br/>Decrypt + Verify"]
        D8{Auth Tag<br/>Valid?}
        D9[/"Plaintext<br/>(OAuth tokens)"/]
        D10["Error:<br/>Decryption Failed"]

        D1 --> D2
        D2 --> D3
        D3 --> D4
        D4 --> D5
        D5 --> D6
        D6 --> D7
        D7 --> D8
        D8 -->|Yes| D9
        D8 -->|No| D10
    end

    subgraph Storage["Encrypted Data Format"]
        direction LR
        S1["IV<br/>(12 bytes)"]
        S2["Ciphertext<br/>(variable)"]
        S3["Auth Tag<br/>(16 bytes)"]

        S1 --- S2
        S2 --- S3
    end

    E8 -.->|"Store"| Storage
    Storage -.->|"Retrieve"| D1

    %% Styling
    classDef input fill:#e3f2fd,stroke:#1565c0
    classDef process fill:#f3e5f5,stroke:#7b1fa2
    classDef output fill:#e8f5e9,stroke:#2e7d32
    classDef error fill:#ffebee,stroke:#c62828
    classDef storage fill:#fff8e1,stroke:#f57f17

    class E1,D1 input
    class E2,E3,E4,E5,E6,E7,D2,D3,D4,D5,D6,D7 process
    class E8,D9 output
    class D10 error
    class S1,S2,S3 storage
