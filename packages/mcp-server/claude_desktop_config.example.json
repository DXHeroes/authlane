{
  "mcpServers": {
    "authlane": {
      "command": "npx",
      "args": [
        "-y",
        "@authlane/mcp-server"
      ],
      "env": {
        "AUTHLANE_API_KEY": "your_api_key_here",
        "AUTHLANE_USER_ID": "your_user_id_here",
        "AUTHLANE_BASE_URL": "http://localhost:3000"
      }
    }
  }
}
