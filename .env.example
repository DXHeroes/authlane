# Never commit a populated .env file. Use a secret manager or mounted secrets in production.
# Generate URL-safe database/Redis passwords with: openssl rand -hex 32
DATABASE_URL=postgresql://authlane:development-only@localhost:5432/authlane
SYSTEM_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Versioned keyrings: current-key-id:64-hex-key[,old-key-id:64-hex-key]
# Generate each independent key with: openssl rand -hex 32
AUTHLANE_DATA_KEK_RING=
AUTHLANE_LOOKUP_KEY_RING=
AUTHLANE_REDIS_KEY_RING=

# Versioned Better Auth secrets: current-version:secret[,old-version:secret]
# Generate each secret with: openssl rand -base64 48
BETTER_AUTH_SECRETS=

API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
AUTHLANE_PUBLIC_DIR=/app/public-product
AUTHLANE_LANDING_DIR=/app/public-landing
AUTHLANE_LANDING_HOSTS=authlane.io
AUTHLANE_APP_HOSTS=app.authlane.io
APP_URL=https://app.authlane.io
BETTER_AUTH_URL=https://app.authlane.io
CORS_ORIGIN=https://app.authlane.io
# Use email-password for local/self-hosted auth, or magic-link with configured email delivery.
AUTHLANE_AUTH_MODE=email-password
# Defaults to true outside production and false in production. Enable only for intentional bootstrap.
AUTHLANE_ALLOW_SIGNUP=false

# Leave empty when the application directly receives traffic. Otherwise list only the
# reverse-proxy CIDRs whose X-Forwarded-For header Authlane may trust.
TRUSTED_PROXY_CIDRS=

# Required in production. Generate with: openssl rand -hex 32
METRICS_BEARER_TOKEN=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Required in production when AUTHLANE_AUTH_MODE=magic-link. Keep the API key runtime-only.
RESEND_API_KEY=
EMAIL_FROM=Authlane <auth@mail.authlane.io>

# Optional platform-wide OAuth applications. A tenant that registers its own application in the
# dashboard always wins; these are the fallback so a tenant can connect without registering one.
# Name them AUTHLANE_OAUTH_<SERVICE_ID>_CLIENT_ID/_CLIENT_SECRET with the service id upper-cased
# and dashes replaced by underscores. Omit the secret for public PKCE-only clients.
# Each application's redirect URI must be https://<your-app-host>/api/v1/oauth/<service-id>/callback
AUTHLANE_OAUTH_GITHUB_CLIENT_ID=
AUTHLANE_OAUTH_GITHUB_CLIENT_SECRET=
AUTHLANE_OAUTH_GMAIL_CLIENT_ID=
AUTHLANE_OAUTH_GMAIL_CLIENT_SECRET=
AUTHLANE_OAUTH_GOOGLE_CALENDAR_CLIENT_ID=
AUTHLANE_OAUTH_GOOGLE_CALENDAR_CLIENT_SECRET=
AUTHLANE_OAUTH_GOOGLE_DRIVE_CLIENT_ID=
AUTHLANE_OAUTH_GOOGLE_DRIVE_CLIENT_SECRET=

# Optional production-like Sandbox agent providers. Configure only providers you intend to use.
# Direct Sandbox tool runs do not require an AI provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Docker Compose-only values. All are required by the production compose file.
POSTGRES_PASSWORD=
AUTHLANE_RUNTIME_DB_PASSWORD=
AUTHLANE_WORKER_DB_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
