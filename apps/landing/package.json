{
  "name": "@authlane/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-next-dev.mjs --defaultPort 3002 --fallbackStartPort 3102",
    "prebuild": "pnpm --dir ../.. openapi:check && pnpm --dir ../.. docs:check",
    "build": "next build && node scripts/postprocess-static.mjs",
    "lint": "next lint",
    "pretest": "pnpm --filter @authlane/shared build",
    "test": "vitest run",
    "pretype-check": "pnpm --filter @authlane/shared build",
    "type-check": "tsc --noEmit && tsc --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@authlane/shared": "workspace:*",
    "@scalar/api-reference-react": "^0.9.58",
    "next": "^15.5.22",
    "next-mdx-remote": "^6.0.0",
    "prismjs": "1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "^20.10.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
