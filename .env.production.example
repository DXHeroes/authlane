# Production Environment Configuration
# Copy this file to .env.production and fill in actual values

# Database
DATABASE_URL=postgresql://user:password@host:5432/authlane_production
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# Redis
REDIS_URL=redis://user:password@host:6379
REDIS_TLS=true
REDIS_MAX_RETRIES=3

# Encryption
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET=generate-with-openssl-rand-hex-32

# API Server
NODE_ENV=production
PORT=3000
API_URL=https://api.authlane.com
CORS_ORIGIN=https://authlane.com,https://dashboard.authlane.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# OAuth Providers (add your production credentials)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@authlane.com

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
