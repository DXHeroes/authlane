{
  "name": "@authlane/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-next-dev.mjs --defaultPort 3002 --fallbackStartPort 3102",
    "prebuild": "pnpm --dir ../.. openapi:check && pnpm --dir ../.. docs:check",
    "build": "next build && node scripts/postprocess-static.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@authlane/shared": "workspace:*",
    "@scalar/api-reference-react": "^0.9.74",
    "next": "^16.3.6",
    "next-mdx-remote": "^6.0.0",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
