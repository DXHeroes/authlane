{
  "name": "example-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others 'pnpm dev:web' 'pnpm dev:server'",
    "dev:web": "vite --port 5174",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/index.js",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@authlane/react": "workspace:*",
    "@authlane/sdk": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.12.34",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
